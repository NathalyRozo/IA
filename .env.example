# ==========================================
# Mediatrix - Plataforma de Análisis de Cobertura y Agenda Mediática
# Variables de Entorno del Sistema
# ==========================================

# Configuración General del Servidor
PROJECT_NAME="Mediatrix - Observatorio de Medios"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="supersecretkey-change-in-production"

# Configuración de Base de Datos
# Por defecto se utiliza SQLite para facilitar ejecución local inmediata.
# Para producción se recomienda PostgreSQL con pgvector: postgresql+asyncpg://user:pass@localhost:5432/mediatrix
DATABASE_URL="sqlite+aiosqlite:///./data/mediatrix.db"

# Orquestador y Recolección
SCRAPING_INTERVAL_HOURS=2
MAX_ARTICLES_PER_FEED=25
USER_AGENT="MediatrixBot/1.0 (+http://observatorio-medios.org/bot; academic-research)"

# Proveedor de Inteligencia Artificial / PLN
# Opciones para LLM: "gemini", "openai", "local"
LLM_PROVIDER="gemini"
GEMINI_API_KEY="tu-api-key-aqui"
OPENAI_API_KEY=""

# Modelos locales o embeddings
EMBEDDING_MODEL_NAME="paraphrase-multilingual-MiniLM-L12-v2"
SIMILARITY_EVENT_THRESHOLD=0.75

# Configuración del Frontend
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
